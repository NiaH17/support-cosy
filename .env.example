# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DeepL (free tier)
DEEPL_API_KEY=your-deepl-api-key



# Slack (optional): incoming-webhook URL. New requests and replies are posted to that channel.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Public address of the app, used for links in Slack messages (defaults to https://support-cosy.vercel.app)
APP_URL=https://support-cosy.vercel.app

# Phone push notifications (optional). Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
VITE_VAPID_PUBLIC_KEY=
